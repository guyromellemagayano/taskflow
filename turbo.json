{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": 12,
  "remoteCache": {
    "enabled": true,
    "signature": true
  },
  "experimentalUI": true,
  "experimentalSpaces": true,
  "globalDependencies": [
    ".env*",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "turbo.json"
  ],
  "globalEnv": [
    "ANALYZE",
    "CI",
    "COOKIE_HTTPONLY",
    "COOKIE_SAMESITE",
    "COOKIE_SECURE",
    "CORS_ORIGINS",
    "DATABASE_URL",
    "DEBUG",
    "ENVIRONMENT",
    "GIT_HASH",
    "JWT_ACCESS_TOKEN_EXPIRE_MINUTES",
    "JWT_ALGORITHM",
    "JWT_REFRESH_TOKEN_EXPIRE_DAYS",
    "JWT_SECRET_KEY",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_GRAPHQL_URL",
    "NODE_ENV",
    "POSTGRES_PORT",
    "REDIS_PORT",
    "REDIS_URL",
    "TURBO_TEAM",
    "TURBO_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "next.config.*",
        "vite.config.*",
        "tsconfig*.json",
        "postcss.config.*",
        "tailwind.config.*",
        "tsup.config.*",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/standalone/**",
        "build/**"
      ],
      "outputLogs": "new-only"
    },
    "codegen": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "codegen.*",
        "codegen.yml",
        "schema.*",
        "*.graphql",
        "*.gql",
        "package.json"
      ],
      "outputs": [
        "**/generated.ts",
        "**/__generated__/**",
        "src/gql/**",
        "src/__generated__/**"
      ],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false,
      "outputLogs": "full"
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "eslint.config.*",
        ".eslintrc.*",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "eslint.config.*",
        ".eslintrc.*",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "lint:format": {
      "dependsOn": ["^lint:format"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "prettier.config.*",
        ".prettierrc.*",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "stylelint": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "stylelint.config.*",
        ".stylelintrc.*",
        "**/*.css",
        "package.json"
      ],
      "outputs": [],
      "cache": true
    },
    "stylelint:fix": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "stylelint.config.*",
        ".stylelintrc.*",
        "**/*.css",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "jest.config.*",
        "playwright.config.*",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": [
        "coverage/**",
        ".coverage/**",
        "test-results/**",
        "playwright-report/**",
        "junit.xml"
      ],
      "outputLogs": "new-only"
    },
    "test:run": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "jest.config.*",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": ["coverage/**", ".coverage/**", "junit.xml"],
      "outputLogs": "new-only"
    },
    "test:run:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "jest.config.*",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": ["coverage/**", ".coverage/**", "junit.xml"],
      "outputLogs": "new-only"
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "playwright.config.*",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": ["test-results/**", "playwright-report/**"],
      "outputLogs": "new-only"
    },
    "format": {
      "dependsOn": ["^format"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "prettier.config.*",
        ".prettierrc.*",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "format:check": {
      "dependsOn": ["^format:check"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "prettier.config.*",
        ".prettierrc.*",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "clean": {
      "cache": false,
      "dependsOn": []
    }
  }
}
