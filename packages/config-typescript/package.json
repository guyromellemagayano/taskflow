{
  "name": "@taskflow/config-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript configuration for TaskFlow monorepo",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./base.json": "./src/base.json",
    "./nextjs.json": "./src/nextjs.json",
    "./react-library.json": "./src/react-library.json"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo dist",
    "format": "prettier --write \"src/**/*.{js,cjs,mjs,ts,cts,mts,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,cjs,mjs,ts,cts,mts,json}\""
  },
  "dependencies": {},
  "devDependencies": {
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {},
  "optionalDependencies": {}
}
