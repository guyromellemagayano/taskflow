{
  "name": "@taskflow/vitest-presets",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Vitest configuration presets for TaskFlow monorepo",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./browser": {
      "types": "./browser/vitest-preset.ts",
      "default": "./browser/vitest-preset.ts"
    },
    "./node": {
      "types": "./node/vitest-preset.ts",
      "default": "./node/vitest-preset.ts"
    },
    "./react": {
      "types": "./react/vitest-preset.ts",
      "default": "./react/vitest-preset.ts"
    },
    "./shared": {
      "types": "./shared/index.ts",
      "default": "./shared/index.ts"
    },
    "./shared/test-setup.ts": {
      "types": "./shared/test-setup.ts",
      "default": "./shared/test-setup.ts"
    }
  },
  "main": "./index.ts",
  "files": [
    "index.ts",
    "browser/**/*.ts",
    "node/**/*.ts",
    "react/**/*.ts",
    "shared/**/*"
  ],
  "scripts": {
    "clean": "rm -rf node_modules .turbo dist",
    "format": "prettier --write \"**/*.{js,cjs,mjs,ts,cts,mts,md,mdx}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,ts,cts,mts,md,mdx}\"",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "test:run": "vitest run",
    "test:run:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "optionalDependencies": {}
}
